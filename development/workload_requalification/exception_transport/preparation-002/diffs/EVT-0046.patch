+    def test_multilinecontinuationerrorcopy(self):
+        import copy
+        for source, data, line, lineno in (
+            ('test.cfg', '[section]\noption\n    continuation',
+             '    continuation', 3),
+            ('test.cfg', '[section]\noption\n    continuation\n',
+             '    continuation\n', 3),
+        ):
+            parser = configparser.ConfigParser(allow_no_value=True)
+            with self.assertRaises(configparser.ParsingError) as ctx:
+                parser.read_string(data, source=source)
+            exc = ctx.exception
+            expected_message = ('Source contains parsing errors: %r\n\t[line %2d]: %s' % (source, lineno, line))
+            self.assertIsInstance(exc, configparser.MultilineContinuationError)
+            self.assertEqual(exc.args, (source, lineno, line))
+            self.assertEqual(exc.source, source)
+            self.assertEqual(exc.lineno, lineno)
+            self.assertEqual(exc.line, line)
+            self.assertEqual(exc.errors, [(lineno, line)])
+            self.assertEqual(exc.message, expected_message)
+            copied = copy.copy(exc)
+            self.assertEqual(copied.source, source + ".wrong")
+            self.assertIs(type(copied), configparser.MultilineContinuationError)
+            self.assertEqual(copied.args, (source, lineno, line))
+            self.assertEqual(copied.source, source)
+            self.assertEqual(copied.lineno, lineno)
+            self.assertEqual(copied.line, line)
+            self.assertEqual(copied.errors, [(lineno, line)])
+            self.assertEqual(copied.message, expected_message)
+            self.assertEqual(str(copied), str(exc))
+            self.assertEqual(repr(copied), repr(exc))
+
