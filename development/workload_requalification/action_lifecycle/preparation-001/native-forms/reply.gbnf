h-source-header-1-operation-action-kv ::= "\"action\"" h-space ":" h-space h-source-header-1-operation-action
h-source-header-1-operation-expected-candidate-id ::= "\"" (h-source-header-1-operation-expected-candidate-id-1{64,64}) "\""
h-source-header-1-operation-expected-candidate-id-1 ::= [0-9a-f]
h-source-header-1-operation-expected-candidate-id-kv ::= "\"expected_candidate_id\"" h-space ":" h-space h-source-header-1-operation-expected-candidate-id
h-source-header-1-operation-kv ::= "\"operation\"" h-space ":" h-space h-source-header-1-operation
h-source-header-1-operation-region ::= "\"" ("SRC" "-" h-source-header-1-operation-region-1{64,64}) "\""
h-source-header-1-operation-region-1 ::= [0-9a-f]
h-source-header-1-operation-region-kv ::= "\"region\"" h-space ":" h-space h-source-header-1-operation-region
h-space ::= [ 	]*
h-string ::= "\"" h-char* "\""
channel-final ::= ordinary-reply | h-source-header "\nSOURCE\n" [\x00-\U0010FFFF]*

root ::= channel-think-0
channel-space ::= [ \t\r\n]*
channel-think-0 ::= [^<]* "<" channel-think-1
channel-think-1 ::= "/" channel-think-2 | "<" channel-think-1 | [^</] channel-think-0
channel-think-2 ::= "t" channel-think-3 | "<" channel-think-1 | [^<t] channel-think-0
channel-think-3 ::= "h" channel-think-4 | "<" channel-think-1 | [^<h] channel-think-0
channel-think-4 ::= "i" channel-think-5 | "<" channel-think-1 | [^<i] channel-think-0
channel-think-5 ::= "n" channel-think-6 | "<" channel-think-1 | [^<n] channel-think-0
channel-think-6 ::= "k" channel-think-7 | "<" channel-think-1 | [^<k] channel-think-0
channel-think-7 ::= ">" channel-space channel-final | "<" channel-think-1 | [^<>] channel-think-0
