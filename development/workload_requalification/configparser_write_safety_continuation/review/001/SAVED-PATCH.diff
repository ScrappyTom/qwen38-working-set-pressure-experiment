+class InvalidWriteError(Error):
+    """Raised when writing an option name that would produce ambiguous output.
+
+    Raised by write() when an option name matches the section header pattern
+    or contains a configured delimiter string.
+    """
+
+    def __init__(self, option):
+        Error.__init__(self, 'Option name %r is ambiguous for writing' % (option,))
+        self.option = option
+        self.args = (option,)
 
 
