urrent source in `src/addressable_information_layer/artifact_units.py`, `reopen.py`, `records.py`, and `hashing.py` before mutation. Do not modify tests or add dependencies. Run check `public` on the current candidate and submit.\"},\"available_actions\":[\"p0_page\",\"tree\",\"search\",\"read\",\"patch\",\"check\",\"reopen_observation\",\"reopen_result\",\"reopen_event\",\"submit\"],\"available_check_ids\":[\"public\"],\"candidate_id\":\"5c7eba4fbad9c51325a9abc4f4b27c5b8d9eedb5b344558b5921915ed854a49f\",\"completed_step_ids\":[],\"current_p0\":{\"access\":\"p0_page\",\"candidate_id\":\"5c7eba4fbad9c51325a9abc4f4b27c5b8d9eedb5b344558b5921915ed854a49f\",\"complete_for_repository\":false,\"complete_for_top_level\":true,\"entries\":[{\"file_count\":25,\"kind\":\"directory\",\"path\":\"src\",\"total_bytes\":128544}],\"ranking\":null,\"schema_version\":\"p0-readable-hierarchical-root-v1\",\"task_independent\":true},\"event_frame_verification\":{\"canonical_payload_reuse_events\":0,\"event_count\":8,\"external_payload_records\":0,\"resident_payload_records\":10,\"signal_contract\":{\"opaque_handle_is_not_the_progress_signal\":true,\"reopen_is_access_not_new_payload\":true,\"resident_action_fields\":\"all action fields except old/new\",\"resident_result_fields\":\"all result fields except exact body fields\"},\"verified\":true},\"fixture_id\":\"E19-SOURCE-REOPEN\",\"latest_transition_binding\":null,\"observation_directory\":{\"complete_for_listed_reopenable_dynamic_results\":true,\"entries\":[],\"ordering\":\"capture_ordinal_ascending\",\"schema_version\":\"exact-observation-directory-v2\",\"semantic_previews\":false},\"p0_contract\":{\"exact_source_required_before_mutation\":true,\"repository_complete\":false,\"root_complete\":true,\"scoped_access\":\"p0_page\",\"semantic_ranking\":false,\"task_independent\":true},\"read_paging_mode\":\"maximal_bounded_page\",\"reconstruction_notice\":\"The ordered events are exact progress. Readable targets, status, ranges, and candidate/file/check bindings are the signal. A canonical payload address identifies exact custody but is not relevance or sufficiency advice. Reopening creates a new access event that retains the same canonical source. Sequence records occurrence, not semantic completion.\",\"resource_state\":{\"call_limit\":24,\"calls_remaining\":16,\"calls_used\":8,\"correction_cycle_reserved_by_fixture_design\":\"check -> patch -> recheck -> submit fits within the prospective ideal path\",\"reasoning_budget_tokens\":512},\"schema_version\":\"experiment-019-ecological-event-frame-request-v1\",\"stage\":\"continuation\",\"task\":\"Repair two regressions in this owner-controlled exact-reopen pipeline. The contract is unambiguous: `ArtifactUnit.start_line` and `end_line` are inclusive, so exact materialization must include every declared source line. `ReopenReceipt.truncated` is true only when the exact text is strictly longer than `max_chars`; equality is complete. Preserve inline-text behavior, hash-mismatch blocking, exact identifiers, and public APIs. Inspect exact current source in `src/addressable_information_layer/artifact_units.py`, `reopen.py`, `records.py`, and `hashing.py` before mutation. Do not modify tests or add dependencies. Run check `public` on the current candidate and submit.\",\"tool_contract\":{\"check\":\"stage-bound exact check on the expected candidate\",\"p0_page\":\"task-independent readable directory or file-outline page; exact source is not included\",\"patch\":\"one exact candidate/file-bound replacement\",\"read\":\"largest exact current whole-line page that fits the frozen result bound, with non-guessing continuation\",\"reopen_event\":\"exactly reopen the canonical patch payload named by resident signal\",\"reopen_observation\":\"continuation-only exact reopen by listed handle\",\"reopen_result\":\"exactly reopen the canonical event-result payload named by resident signal\",\"search\":\"literal case-folded current-source search\",\"submit\":\"continuation-onl