e-format-3-start-line\nresponse-format-4 ::= \"{\" space response-format-4-action-kv \",\" space response-format-4-expected-candidate-id-kv \",\" space response-format-4-expected-file-sha256-kv \",\" space response-format-4-new-kv \",\" space response-format-4-old-kv \",\" space response-format-4-path-kv space \"}\"\nresponse-format-4-action ::= \"\\\"patch\\\"\"\nresponse-format-4-action-kv ::= \"\\\"action\\\"\" space \":\" space response-format-4-action\nresponse-format-4-expected-candidate-id ::= \"\\\"\" (response-format-4-expected-candidate-id-1{64,64}) \"\\\"\"\nresponse-format-4-expected-candidate-id-1 ::= [0-9a-f]\nresponse-format-4-expected-candidate-id-kv ::= \"\\\"expected_candidate_id\\\"\" space \":\" space response-format-4-expected-candidate-id\nresponse-format-4-expected-file-sha256 ::= \"\\\"\" (response-format-4-expected-file-sha256-1{64,64}) \"\\\"\"\nresponse-format-4-expected-file-sha256-1 ::= [0-9a-f]\nresponse-format-4-expected-file-sha256-kv ::= \"\\\"expected_file_sha256\\\"\" space \":\" space response-format-4-expected-file-sha256\nresponse-format-4-new ::= \"\\\"\" char{0,512} \"\\\"\"\nresponse-format-4-new-kv ::= \"\\\"new\\\"\" space \":\" space response-format-4-new\nresponse-format-4-old ::= \"\\\"\" char{0,512} \"\\\"\"\nresponse-format-4-old-kv ::= \"\\\"old\\\"\" space \":\" space response-format-4-old\nresponse-format-4-path ::= \"\\\"\" char{1,160} \"\\\"\"\nresponse-format-4-path-kv ::= \"\\\"path\\\"\" space \":\" space response-format-4-path\nresponse-format-5 ::= \"{\" space response-format-5-action-kv \",\" space response-format-5-check-id-kv \",\" space response-format-5-expected-candidate-id-kv space \"}\"\nresponse-format-5-action ::= \"\\\"check\\\"\"\nresponse-format-5-action-kv ::= \"\\\"action\\\"\" space \":\" space response-format-5-action\nresponse-format-5-check-id ::= (\"\\\"prefork\\\"\" | \"\\\"public\\\"\")\nresponse-format-5-check-id-kv ::= \"\\\"check_id\\\"\" space \":\" space response-format-5-check-id\n